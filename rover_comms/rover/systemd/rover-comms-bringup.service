[Unit]
# Waveshare UGV driver launched with the Discovery Server environment so the
# desktop can reach it. Supersedes ugv-bringup.service for comms use — enable
# only ONE driver service to avoid two drivers fighting over the hardware.
Description=UGV rover driver + Fast DDS Discovery Server client (desktop link)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__ROVER_USER__
# Point services at the installed env; mode comes from ~/.config/rover_comms/mode
Environment=ROVER_COMMS_ENV=/usr/local/lib/rover_comms/rover_env.sh
Environment=XDG_CONFIG_HOME=__ROVER_HOME__/.config
ExecStart=/usr/local/bin/rover-bringup
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
