#!/usr/bin/env bash
# rover-teleop-test — publish a short, gentle /cmd_vel from the rover itself to
# confirm the drive path works locally (independent of the desktop).
#
#   rover-teleop-test [linear_x] [angular_z] [duration_s]
# defaults: 0.05 m/s forward, no turn, 1.0 s, then an explicit stop.
#
# WARNING: this physically moves the rover. Keep it clear.
set -eo pipefail

LIN="${1:-0.05}"
ANG="${2:-0.0}"
DUR="${3:-1.0}"

ROVER_ENV="$(command -v rover-env || echo /usr/local/bin/rover-env)"

echo "Publishing /cmd_vel linear.x=${LIN} angular.z=${ANG} for ${DUR}s (then stop)."
echo "This moves every robot on this ROS domain subscribed to /cmd_vel. Ctrl-C to abort."
sleep 2

"${ROVER_ENV}" bash -lc "
  timeout ${DUR} ros2 topic pub -r 10 /cmd_vel geometry_msgs/msg/Twist \
    '{linear: {x: ${LIN}, y: 0.0, z: 0.0}, angular: {x: 0.0, y: 0.0, z: ${ANG}}}' || true
  ros2 topic pub --once /cmd_vel geometry_msgs/msg/Twist \
    '{linear: {x: 0.0, y: 0.0, z: 0.0}, angular: {x: 0.0, y: 0.0, z: 0.0}}'
"
echo "Done (stop command sent)."
