# Generated ROS/colcon outputs
build/
install/
log/
**/build/
**/install/
**/log/

# Python/cache output
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local editor/OS files
.DS_Store
.vscode/
.idea/
*~
.git-backups/

# Isaac/ROS runtime files that should be regenerated locally
*.bag
*.db3
*.mcap
*.log

# Keep source assets and USD files tracked; ignore only backup churn.
*.bak
*.bak-*

# Thesis experiment trial outputs (CSVs/plots) — keep specific results with git add -f
experiments/data/

# sim2real_calib generated results - local catalog: sim2real_calib/RESULTS.md
sim2real_calib/loop/runs/
sim2real_calib/demo/runs/
sim2real_calib/navcmp/runs/
sim2real_calib/optimize/runs/

# Local calibration backups and rig-profile history/progress
sim2real_calib/calib/*.before_regrid_*.json
sim2real_calib/rig_profiles/_autosave/
sim2real_calib/rig_profiles/*/history/
sim2real_calib/rig_profiles/*/demo_state.json

# Generated navigation recordings and large RTAB-Map databases
experiments/runs/
experiments/replay_video/*.mp4
experiments/maps/**/*.db

# LaTeX build intermediates (keep source and final PDFs)
*.aux
*.fdb_latexmk
*.fls
*.toc
*.synctex.gz

# Local camera bootstrap credentials
ts-authkey
