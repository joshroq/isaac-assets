# Source this file on the Jetson, laptop, and Isaac host.
# Keep values identical across all machines that need to share ROS 2 traffic.

ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_LOCALHOST_ONLY=0

# Optional Cyclone DDS config path if you switch RMW_IMPLEMENTATION to
# rmw_cyclonedds_cpp. Leave unset for Fast DDS.
# CYCLONEDDS_URI=file:///etc/ros/cyclonedds.xml

# Repo/workspace defaults used by helper scripts on the Jetson.
ISAAC_ASSETS_DIR=${HOME}/isaac-assets
UGV_WS=${HOME}/isaac-assets/ugv_ws
