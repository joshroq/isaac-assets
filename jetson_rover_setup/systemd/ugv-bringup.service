[Unit]
Description=Waveshare UGV ROS 2 bringup
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__ROVER_USER__
Environment=UGV_ENV_FILE=__ROVER_HOME__/isaac-assets/jetson_rover_setup/env/ros2_rover.env
ExecStart=/usr/local/bin/ugv-bringup
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
