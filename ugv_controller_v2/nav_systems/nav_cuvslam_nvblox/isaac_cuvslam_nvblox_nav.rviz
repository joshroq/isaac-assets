# cuVSLAM + nvblox navigation view.
#
# This is intentionally conservative for the RTX 5060 Ti / Humble RViz setup here:
# no point-cloud/laser-scan display, pose-array arrows, or markers — those trigger the
# missing rviz/glsl150/box.geom abort on this machine's rviz-rendering 11.2.27. The Nav2
# panel IS kept — it's the required /goal_pose -> NavigateToPose bridge for the goal tool.
# It shows the nvblox 3D reconstruction mesh (safe because the launch forces the plugin's
# fallback material via ISAAC_ROS_NVBLOX_PLUGIN_FORCE_FALLBACK_MATERIAL=1) plus the 2D
# navigation surface Nav2 actually consumes:
#   - /nvblox_node/mesh                     (the 3D reconstruction)
#   - /global_costmap/costmap + /local_costmap/costmap  (nvblox ESDF slice)
#   - /plan and /local_plan
#   - cuVSLAM corrected and raw visual odometry paths
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /Navigation Costmaps1
        - /cuVSLAM Tracking1
      Splitter Ratio: 0.5
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
  # REQUIRED to drive via the "2D Goal Pose" tool: bt_navigator does NOT subscribe to
  # /goal_pose — this panel is the bridge that forwards the tool's /goal_pose to the
  # NavigateToPose action. Without it, goal clicks do nothing. It's a Qt panel (no Ogre
  # shaders), so it does not risk the box.geom abort that the 3D point displays do.
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: RobotModel
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.4
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: false
    # nvblox 3D reconstruction mesh. Safe here ONLY because the launch sets
    # ISAAC_ROS_NVBLOX_PLUGIN_FORCE_FALLBACK_MATERIAL=1 on the rviz2 process, forcing the
    # plugin's built-in BaseWhiteNoLighting material instead of its default rviz/glsl150/
    # box.geom path (that geometry program is missing from this box's rviz-rendering and
    # would abort RViz). The mesh renders plain/untextured (use_color is off anyway).
    - Class: nvblox_rviz_plugin/NvbloxMesh
      Enabled: true
      Name: Nvblox 3D Mesh
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /nvblox_node/mesh
      Value: true
    - Class: rviz_common/Group
      Displays:
        - Alpha: 0.75
          Class: rviz_default_plugins/Map
          Color Scheme: costmap
          Draw Behind: true
          Enabled: true
          Name: Global Costmap - nvblox ESDF
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /global_costmap/costmap
          Update Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /global_costmap/costmap_updates
          Use Timestamp: false
          Value: true
        - Alpha: 0.45
          Class: rviz_default_plugins/Map
          Color Scheme: costmap
          Draw Behind: false
          Enabled: true
          Name: Local Costmap - nvblox ESDF
          Topic:
            Depth: 1
            Durability Policy: Transient Local
            Filter size: 10
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /local_costmap/costmap
          Update Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /local_costmap/costmap_updates
          Use Timestamp: false
          Value: true
      Enabled: true
      Name: Navigation Costmaps
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 25; 255; 0
          Enabled: true
          Head Diameter: 0
          Head Length: 0
          Length: 0.3
          Line Style: Lines
          Line Width: 0.035
          Name: Global Plan
          Offset:
            X: 0
            Y: 0
            Z: 0.02
          Pose Style: None
          Radius: 0.03
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /plan
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 0; 170; 255
          Enabled: true
          Head Diameter: 0
          Head Length: 0
          Length: 0.3
          Line Style: Lines
          Line Width: 0.035
          Name: Local Plan
          Offset:
            X: 0
            Y: 0
            Z: 0.04
          Pose Style: None
          Radius: 0.03
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /local_plan
          Value: true
      Enabled: true
      Name: Nav2 Plans
    - Class: rviz_common/Group
      Displays:
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 170; 0
          Enabled: true
          Head Diameter: 0
          Head Length: 0
          Length: 0.3
          Line Style: Lines
          Line Width: 0.035
          Name: cuVSLAM SLAM Path
          Offset:
            X: 0
            Y: 0
            Z: 0.08
          Pose Style: None
          Radius: 0.03
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /visual_slam/tracking/slam_path
          Value: true
        - Alpha: 1
          Buffer Length: 1
          Class: rviz_default_plugins/Path
          Color: 255; 85; 255
          Enabled: true
          Head Diameter: 0
          Head Length: 0
          Length: 0.3
          Line Style: Lines
          Line Width: 0.025
          Name: cuVSLAM VO Path
          Offset:
            X: 0
            Y: 0
            Z: 0.1
          Pose Style: None
          Radius: 0.03
          Topic:
            Depth: 5
            Durability Policy: Volatile
            History Policy: Keep Last
            Reliability Policy: Reliable
            Value: /visual_slam/tracking/vo_path
          Value: true
      Enabled: true
      Name: cuVSLAM Tracking
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.0685389
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0.4
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.7
      Target Frame: base_link
      Value: Orbit (rviz)
      Yaw: 1.57
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Views:
    collapsed: false
  Width: 1400
  X: 80
  Y: 80
